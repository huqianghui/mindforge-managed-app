{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-ms-validation": true,
  "x-ms-locale": "en-SG",
  "$defs": {
    "readingState": {
      "type": "object",
      "x-ms-ownership": "perUser",
      "description": "Mindforge reading progress and favorites, one item per user and article",
      "properties": {
        "docPath": {
          "type": "string",
          "maxLength": 400,
          "x-ms-index": {
            "ignoreCase": false
          }
        },
        "scroll": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "lastReadAt": {
          "type": "string",
          "format": "date-time"
        },
        "favorite": {
          "type": "boolean"
        }
      },
      "required": [
        "docPath"
      ]
    },
    "learningState": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 200,
          "x-ms-index": {
            "ignoreCase": false
          }
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "key"
      ],
      "x-ms-ownership": "perUser",
      "description": "Mindforge learning progress and quiz review state, one item per user and key (station:<path>/<n> or quiz:<question id>)"
    }
  }
}
